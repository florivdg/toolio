---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import type { CollectionEntry } from 'astro:content'

interface Props {
  doc: CollectionEntry<'docs'>
}

const { doc } = Astro.props

// Resolved here rather than in the markup, so the card body stays a plain list
// of fields.
const title = doc.data.title || doc.id
const tags = doc.data.tags ?? []
const createdAt = doc.data.createdAt?.toLocaleDateString('de-DE')
---

<a href={`/docs/${doc.id}`} class="block">
  <Card class="h-full cursor-pointer transition-shadow hover:shadow-lg">
    <CardHeader>
      <CardTitle>{title}</CardTitle>
      {
        doc.data.description && (
          <CardDescription>{doc.data.description}</CardDescription>
        )
      }
    </CardHeader>
    <CardContent>
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
      </div>
      {
        createdAt && (
          <p class="text-muted-foreground mt-4 text-sm">
            Erstellt: {createdAt}
          </p>
        )
      }
    </CardContent>
  </Card>
</a>
