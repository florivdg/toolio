---
import App from '@/layouts/App.astro'
import PageHeader from '@/components/PageHeader.astro'
import SignOutButton from '@/components/auth/sign-out-button.vue'
import PasskeyManager from '@/components/auth/passkey-manager.vue'
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'

const userSession = Astro.locals.session
---

<App>
  <PageHeader title="Account" />

  <section class="my-8 space-y-8">
    <!-- Session Information -->
    <Card class="w-full max-w-4xl">
      <CardHeader>
        <CardTitle>Information zur Session</CardTitle>
        <CardDescription>
          Dies sind die Sitzungsinformationen für den angemeldeten Benutzer.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <div class="space-y-2">
          <p><strong>Nutzer-ID:</strong> {userSession!.userId}</p>
          <p><strong>Erstellt am:</strong> {new Date(userSession!.createdAt).toLocaleString('de-DE')}</p>
          <p><strong>Läuft ab am:</strong> {new Date(userSession!.expiresAt).toLocaleString('de-DE')}</p>
        </div>
      </CardContent>
      <CardFooter>
        <SignOutButton client:load />
      </CardFooter>
    </Card>

    <!-- Passkey Management -->
    <div class="w-full max-w-4xl">
      <PasskeyManager client:load />
    </div>
  </section>
</App>
